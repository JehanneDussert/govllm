# Redis
REDIS_URL=redis://redis:6379

# App
ALLOWED_ORIGINS=["http://localhost:5173"]

VITE_GATEWAY_URL=http://localhost:8001
VITE_OBSERVABILITY_URL=http://localhost:8002
VITE_EVALUATION_URL=http://localhost:8003

DEFAULT_MODEL=ollama/phi4-mini
BENCHMARK_MODELS=["ollama/phi4-mini","ollama/mistral:7b","ollama/gemma3:4b","ollama/qwen3:1.7b"]

# Arena DB (PostgreSQL — reuses Langfuse DB, tables in govllm schema, search_path set per-connection in database.py)
